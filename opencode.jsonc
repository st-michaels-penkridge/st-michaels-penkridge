{
  "$schema": "https://opencode.ai/config.json",

  // Start every session on the lead agent, which works through .ai/PLAN.md
  "default_agent": "lead",

  // Rules for every agent. Agent files add their own rules after these.
  "permissions": [
    { "action": "read", "resource": "**/.env*", "effect": "deny" },
    { "action": "edit", "resource": "**/.env*", "effect": "deny" },
    { "action": "edit", "resource": "members/**", "effect": "ask" },
    { "action": "edit", "resource": "CNAME", "effect": "deny" },

    // The tests are the referee: agents can't change them
    { "action": "edit", "resource": "tests/**", "effect": "deny" },
    { "action": "edit", "resource": ".github/**", "effect": "deny" },
    { "action": "edit", "resource": "package.json", "effect": "deny" },
    { "action": "edit", "resource": "package-lock.json", "effect": "deny" },
    { "action": "edit", "resource": "playwright.config.mjs", "effect": "deny" },
    { "action": "edit", "resource": ".htmlvalidate*", "effect": "deny" },
    { "action": "edit", "resource": "linkinator.config.json", "effect": "deny" },

    // Only Tobi touches git history
    { "action": "shell", "resource": "git commit*", "effect": "deny" },
    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "shell", "resource": "git reset*", "effect": "deny" },
    { "action": "shell", "resource": "git checkout*", "effect": "deny" }
  ]
}
